# Wedding AI Studio Environment Variables

# Gemini AI API Key (Required for image analysis)
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Required for image generation with DALL-E)
# Get your API key from: https://platform.openai.com/api-keys
# To use OpenAI, also update server.js to use generate-openai.js route
OPENAI_API_KEY=your_openai_api_key_here

# Server Configuration
PORT=5000

# Optional: Node Environment
NODE_ENV=development
